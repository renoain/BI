SET @i = 1;
WHILE @i <= 68
BEGIN
    DECLARE @namaDepan NVARCHAR(50);
    DECLARE @namaBelakang NVARCHAR(50);
    
    SELECT @namaDepan = nama FROM @nama_depan WHERE id = @i;
    
    -- Pilih nama belakang random
    SELECT TOP 1 @namaBelakang = nama 
    FROM @nama_belakang 
    ORDER BY ABS(CHECKSUM(NEWID())) % 18;
    
    INSERT INTO Penjual (id_penjual, nama_penjual)
    VALUES (@i, @namaDepan + ' ' + @namaBelakang);
    
    SET @i = @i + 1;
END

-- Produk Terlaris
PRINT '--- Produk Terlaris ---';
SELECT 
    pr.nama_produk,
    pr.kategori,
    COUNT(*) AS jumlah_terjual,
    SUM(dp.jumlah) AS total_cup,
    SUM(dp.total_harga) AS total_pendapatan
FROM DetailPembayaran dp
JOIN Produk pr ON dp.id_produk = pr.id_produk
GROUP BY pr.nama_produk, pr.kategori
ORDER BY total_cup DESC;

-- Pendapatan per Bulan
PRINT '';
PRINT '--- Pendapatan per Bulan 2025 ---';
SELECT 
    MONTH(t.tanggal) AS bulan,
    COUNT(DISTINCT t.id_transaksi) AS jumlah_transaksi,
    SUM(dp.total_harga) AS total_pendapatan
FROM Transaksi t
JOIN DetailPembayaran dp ON t.id_transaksi = dp.id_transaksi
GROUP BY MONTH(t.tanggal)
ORDER BY bulan;

-- Metode Pembayaran
PRINT '';
PRINT '--- Distribusi Metode Pembayaran ---';
SELECT 
    metode_pembayaran,
    COUNT(*) AS jumlah_transaksi,
    SUM(total_harga) AS total_pendapatan,
    CAST(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM DetailPembayaran) AS DECIMAL(5,2)) AS persentase
FROM DetailPembayaran
GROUP BY metode_pembayaran;

-- Top 10 Penjual dengan Pendapatan Tertinggi
PRINT '';
PRINT '--- Top 10 Penjual Terbaik ---';
SELECT TOP 10
    p.nama_penjual,
    COUNT(DISTINCT t.id_transaksi) AS jumlah_transaksi,
    SUM(dp.total_harga) AS total_pendapatan
FROM Penjual p
JOIN Gerobak g ON p.id_penjual = g.id_penjual
JOIN Transaksi t ON g.id_gerobak = t.id_gerobak
JOIN DetailPembayaran dp ON t.id_transaksi = dp.id_transaksi
GROUP BY p.nama_penjual
ORDER BY total_pendapatan DESC;


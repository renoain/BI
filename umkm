-- Database: Sistem Manajemen Penjualan Kopi Keliling
-- Kompatibel dengan SQL Server 2008+
-- ============================================

-- Buat Database
IF NOT EXISTS (SELECT name FROM sys.databases WHERE name = 'UMKM_KopiKeliling')
BEGIN
    CREATE DATABASE UMKM_KopiKeliling;
END
GO

USE UMKM_KopiKeliling;
GO

-- ============================================
-- DROP TABEL JIKA SUDAH ADA (urutan sesuai dependensi)
-- ============================================
IF OBJECT_ID('DetailPembayaran', 'U') IS NOT NULL DROP TABLE DetailPembayaran;
IF OBJECT_ID('Transaksi', 'U') IS NOT NULL DROP TABLE Transaksi;
IF OBJECT_ID('Produk', 'U') IS NOT NULL DROP TABLE Produk;
IF OBJECT_ID('Gerobak', 'U') IS NOT NULL DROP TABLE Gerobak;
IF OBJECT_ID('Penjual', 'U') IS NOT NULL DROP TABLE Penjual;
GO

-- ============================================
-- 1. TABEL PENJUAL
-- ============================================
CREATE TABLE Penjual (
    id_penjual INT PRIMARY KEY,
    nama_penjual NVARCHAR(100) NOT NULL
);
GO

-- ============================================
-- 2. TABEL GEROBAK
-- ============================================
CREATE TABLE Gerobak (
    id_gerobak INT PRIMARY KEY,
    id_penjual INT NOT NULL,
    CONSTRAINT FK_Gerobak_Penjual FOREIGN KEY (id_penjual) 
        REFERENCES Penjual(id_penjual)
);
GO

-- ============================================
-- 3. TABEL PRODUK
-- ============================================
CREATE TABLE Produk (
    id_produk INT PRIMARY KEY,
    nama_produk NVARCHAR(100) NOT NULL,
    kategori NVARCHAR(50) NOT NULL,
    harga INT NOT NULL
);
GO

-- ============================================
-- 4. TABEL TRANSAKSI
-- ============================================
CREATE TABLE Transaksi (
    id_transaksi INT PRIMARY KEY,
    tanggal DATE NOT NULL,
    id_gerobak INT NOT NULL,
    CONSTRAINT FK_Transaksi_Gerobak FOREIGN KEY (id_gerobak) 
        REFERENCES Gerobak(id_gerobak)
);
GO

-- ============================================
-- 5. TABEL DETAIL PEMBAYARAN
-- ============================================
CREATE TABLE DetailPembayaran (
    id_detail INT PRIMARY KEY,
    id_transaksi INT NOT NULL,
    id_produk INT NOT NULL,
    jumlah INT NOT NULL,
    metode_pembayaran NVARCHAR(10) NOT NULL,
    total_harga INT NOT NULL,
    CONSTRAINT FK_Detail_Transaksi FOREIGN KEY (id_transaksi) 
        REFERENCES Transaksi(id_transaksi),
    CONSTRAINT FK_Detail_Produk FOREIGN KEY (id_produk) 
        REFERENCES Produk(id_produk),
    CONSTRAINT CK_MetodePembayaran CHECK (metode_pembayaran IN ('Cash', 'QRIS'))
);
GO

